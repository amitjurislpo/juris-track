# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. The docker-compose.yml in this repo starts a
# local database matching these defaults (`npm run db:up`).
DATABASE_URL="postgresql://juristrack:juristrack@localhost:5432/juristrack?schema=public"

# Credentials used by docker-compose.yml for the local database container.
POSTGRES_USER="juristrack"
POSTGRES_PASSWORD="juristrack"
POSTGRES_DB="juristrack"

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret used to HMAC session tokens before they are stored. Must be at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Session lifetime in hours (sliding expiry).
SESSION_TTL_HOURS="12"

# ─── Organization ────────────────────────────────────────────────────────────
# Default organization timezone (IANA name). Used when the settings row is
# first created; afterwards it is managed in Admin → Settings.
ORG_TIMEZONE="Asia/Kolkata"

# ─── Development seed ────────────────────────────────────────────────────────
# Password assigned to every seeded demo account (development only).
SEED_DEMO_PASSWORD="Demo@12345"
